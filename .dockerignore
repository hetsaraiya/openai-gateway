auth/
*.json
.env
*.env
!.env.example
!web/package.json
!web/tsconfig.json
!web/tsconfig.app.json
!web/tsconfig.node.json

# --- python / project cruft ---
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# --- vcs / ci / docs / tests (not needed at runtime) ---
.git/
.github/
.gitignore
tests/
*.md
docker-compose.yml
Dockerfile
.dockerignore
.DS_Store
web/node_modules/
web/dist/
