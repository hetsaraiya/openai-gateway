# ---- Gateway ----------------------------------------------------------------
# Master key your clients present to the gateway (NOT an OpenAI key).
GATEWAY_API_KEY=change-me-to-a-long-random-string

# Folder holding one Codex auth.json per account (see auth/README.md).
AUTH_DIR=auth

# Routing strategy: round_robin | quota_aware | fallback
ROUTING_STRATEGY=fallback

# Seconds to bench an account after it returns a 429.
RATE_LIMIT_COOLDOWN=60

# Try at most this many accounts before giving up on a single request.
MAX_ACCOUNT_ATTEMPTS=3

# Upstream request timeout in seconds (long, for slow completions).
REQUEST_TIMEOUT=600

# Default model when a /v1/chat/completions request omits one. Leave empty to
# resolve it from the live model catalog (highest-priority listed model).
DEFAULT_MODEL=

# Idempotency-Key based dedup (prevents double-spend on retries).
DEDUP_ENABLED=true
DEDUP_TTL=600

# ---- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---- Codex backend / OAuth --------------------------------------------------
# These default to the values the Codex CLI uses; only change if OpenAI rotates
# them or you are pointing at a different environment.
CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
OAUTH_TOKEN_URL=https://auth.openai.com/oauth/token
# CODEX_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
# Refresh the access token this many seconds before it expires.
TOKEN_REFRESH_SKEW=300
# CODEX_ORIGINATOR=codex_cli_rs
# CODEX_OPENAI_BETA=responses=experimental
# Sent as ?client_version= when listing models (backend gates models on it).
CODEX_CLIENT_VERSION=0.145.0
# Official CLI used for Cursor subscription browser login and headless runs.
CURSOR_BINARY=cursor-agent
# Seconds to trust the fetched model catalog before revalidating (ETag).
MODELS_CACHE_TTL=3600

# ---- OpenCode Go ------------------------------------------------------------
# Optional comma-separated OpenCode Go subscription API keys. You can also
# upload/store a JSON file with: {"type":"opencode-go","api_key":"..."}.
OPENCODE_GO_API_KEYS=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

# ---- xAI --------------------------------------------------------------------
# Grok subscription OAuth and CLI chat proxy. Accounts are added with the
# dashboard's xAI device sign-in; no xAI developer API key is used.
XAI_BASE_URL=https://cli-chat-proxy.grok.com/v1
XAI_OAUTH_ISSUER=https://auth.x.ai
XAI_OAUTH_CLIENT_ID=b1a00492-073a-47ea-816f-4c329264a828
GROK_CLIENT_VERSION=0.2.112
